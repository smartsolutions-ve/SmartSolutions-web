# ─────────────────────────────────────────
# SmartSolutions VE — Variables de Entorno
# Copia este archivo a .env y completa los valores
# NUNCA subas .env a Git
# ─────────────────────────────────────────

# === DJANGO ===
SECRET_KEY=cambia-esto-genera-con-python-secrets-token-urlsafe-50
DEBUG=False
ALLOWED_HOSTS=smartsolutions.com.ve,www.smartsolutions.com.ve,TU_IP_AQUI
CSRF_TRUSTED_ORIGINS=https://smartsolutions.com.ve,https://www.smartsolutions.com.ve

# === BASE DE DATOS ===
# DB_HOST=db  ← nombre del servicio en docker-compose (no cambiar)
DB_NAME=smartsolutions
DB_USER=smartsolutions
DB_PASSWORD=contraseña-segura-aqui
DB_HOST=db
DB_PORT=5432

# === EMAIL (Resend — https://resend.com) ===
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=noreply@smartsolutions.com.ve
CONTACT_EMAIL=contacto@smartsolutions.com.ve

# === URL DEL SITIO ===
SITE_URL=https://smartsolutions.com.ve

# Generar SECRET_KEY:
# python3 -c "import secrets; print(secrets.token_urlsafe(50))"
